%% C4 Nivel 2 — Contenedores · AudioShare
%% Diagrama de tipo: C4 Model, Nivel 2 (Contenedores)
%% Actualizado tras el cierre de S10 para incluir el cliente Flutter.
%% Estado real al hash calificado de S10 (1da287c):
%%  - Hay dos clientes alternativos: Flutter (preferido por el bootstrap,
%%    src/server.ts con serveFlutterWeb: true) y el web legado de public/
%%    (fallback de src/app.ts si no existe build/web/index.html).
%%  - Ambos usan solo REST/JSON. Ninguno consume todavía el stream NDJSON,
%%    ni GET /time, ni el ACK de arranque: hoy el stream solo lo consumen
%%    los receptores simulados de tests/support/simulated-receiver.ts.
%%  - El servidor es un monolito modular de un solo proceso con SQLite.
%%  - ADR-0007 (corrección de reloj y ACK) está aceptado, pero su parte de
%%    cliente (Flutter) sigue pendiente de integrar.

graph TB
    %% Usuarios del Nivel 1
    subgraph Emisor_Node ["<center><b>&laquo;person&raquo;</b><br/>👤<br/><b>Usuario Emisor / Moderador</b></center>"]
        E_desc["Crea la sala, administra la sesión e inicia la reproducción desde el navegador."]
    end

    subgraph Receptor_Node ["<center><b>&laquo;person&raquo;</b><br/>👤<br/><b>Usuario Receptor</b></center>"]
        R_desc["Se une a la sala en la misma red Wi-Fi y recibe los eventos de reproducción."]
    end

    %% Límite del Sistema AudioShare (Contenedores reales)
    subgraph System_Boundary ["<b>Sistema AudioShare (Límite del Sistema)</b>"]

        %% Contenedor 1a: Cliente Flutter (preferido)
        subgraph FlutterClient ["<center><b>&laquo;container: Flutter&raquo;</b><br/>📱<br/><b>Cliente Flutter (Material 3)</b></center>"]
            FC_desc["App Flutter (ViewModel → RoomRepository → ApiClient). Consume la API REST/JSON con consultas y operaciones PLAY/PAUSE. Su compilación web (build/web) la sirve el mismo Express. Audio simulado (MockAudioService). Pendiente de integrar: stream NDJSON, GET /time y ACK de arranque."]
        end

        %% Contenedor 1b: Cliente web legado (fallback)
        subgraph WebClient ["<center><b>&laquo;container: navegador&raquo;</b><br/>🌐<br/><b>Cliente web legado (public/)</b></center>"]
            WC_desc["Fallback: se sirve desde public/ cuando no existe build/web/index.html. Consume solo la API REST/JSON; no consume el stream NDJSON. No es un proceso independiente."]
        end

        %% Contenedor 2: Servidor AudioShare (monolito modular)
        subgraph AppServer
            AS_desc["Un solo proceso Node.js/Express. Expone la API REST, GET /time, el ACK de arranque y el stream de eventos NDJSON (que hoy consumen solo los receptores simulados de las pruebas). Organizado en los módulos Session, Sync y Audio (ver ADR-0001, ADR-0009 y C4 Nivel 3). Desplegado con Dokploy (ADR-0008)."]
        end

        %% Contenedor 3: Base de datos
        subgraph SqliteDb ["<center><b>&laquo;container: SQLite (archivo)&raquo;</b><br/>🗄️<br/><b>Base de datos de salas</b></center>"]
            DB_desc["Persiste salas, participantes y estado de reproducción en data/audioshare.sqlite mediante better-sqlite3."]
        end

    end

    %% Relaciones entre Usuarios y Contenedores
    Emisor_Node -->|"1. Abre la app y controla la sala<br/><i>[HTTPS]</i>"| FlutterClient
    Receptor_Node -->|"2. Abre la app y se une a la sala<br/><i>[HTTPS]</i>"| FlutterClient
    Emisor_Node -.->|"1b. Alternativa legada<br/><i>[HTTPS]</i>"| WebClient
    Receptor_Node -.->|"2b. Alternativa legada<br/><i>[HTTPS]</i>"| WebClient

    %% Relaciones internas entre contenedores
    FlutterClient -->|"3. Crea sala, une receptores, consulta estado, PLAY/PAUSE<br/><i>[JSON / HTTPS REST]</i>"| AppServer
    WebClient -->|"4. Crea sala, une receptores, consulta estado, PLAY/PAUSE<br/><i>[JSON / HTTPS REST]</i>"| AppServer
    FlutterClient -.->|"5. PENDIENTE: eventos sync.start, sync.pause y audio.chunk; GET /time y ACK<br/><i>[NDJSON / HTTP streaming; JSON / HTTPS REST]</i>"| AppServer
    AppServer -->|"6. Lee y escribe salas, participantes y estado de reproducción<br/><i>[SQL / better-sqlite3]</i>"| SqliteDb

    %% Leyenda explícita
    subgraph Leyenda ["Leyenda del Diagrama (C4 Nivel 2)"]
        L_Person["👤 Persona / Actor"]
        L_Container["📦 Contenedor Desplegable (App / Servicio / Datos)"]
        L_Rel["───► Flujo implementado (propósito y protocolo/formato)"]
        L_Pend["╌╌► Alternativa o flujo pendiente de integrar"]
    end

    %% Estilos CSS
    classDef personStyle fill:#08427b,stroke:#052e56,color:#fff,stroke-width:1px;
    classDef containerStyle fill:#1168bd,stroke:#0b4884,color:#fff,stroke-width:1px;
    classDef dbStyle fill:#0d5c3f,stroke:#083f2b,color:#fff,stroke-width:1px;
    classDef boundaryStyle fill:none,stroke:#666,stroke-width:2px,stroke-dasharray: 5 5;
    classDef legendStyle fill:#f9f9f9,stroke:#ccc,color:#333;

    class Emisor_Node,Receptor_Node,L_Person personStyle;
    class FlutterClient,WebClient,AppServer,L_Container containerStyle;
    class SqliteDb dbStyle;
    class System_Boundary boundaryStyle;
    class Leyenda legendStyle;