graph TB
    %% Usuarios del Nivel 1
    subgraph Emisor_Node ["<center><b>&laquo;person&raquo;</b><br/>👤<br/><b>Usuario Emisor / Moderador</b></center>"]
        E_desc["Crea salas, administra la sesión y transmite audio desde el navegador o app."]
    end

    subgraph Receptor_Node ["<center><b>&laquo;person&raquo;</b><br/>👤<br/><b>Usuario Receptor</b></center>"]
        R_desc["Se une a salas en la misma red Wi-Fi y reproduce el flujo de audio recibido."]
    end

    %% Límite del Sistema AudioShare (Contenedores)
    subgraph System_Boundary ["<b>Sistema AudioShare (Límite del Sistema)</b>"]
        
        %% Contenedor 1: Web / Frontend Application
        subgraph WebApp ["<center><b>&laquo;container: Web Application&raquo;</b><br/>💻<br/><b>Aplicación Cliente (Frontend)</b></center>"]
            WA_desc["Interfaz SPA (React/Vue/JS) que corre en el navegador. Maneja UI de la sala, controles de audio y llamadas WebRTC."]
        end

        %% Contenedor 2: Discovery Service (mDNS/UPnP)
        subgraph DiscoverySvc ["<center><b>&laquo;container: Node.js / Go Service&raquo;</b><br/>🔍<br/><b>Servicio de Descubrimiento Local</b></center>"]
            DS_desc["Anuncia y descubre salas de transmisión disponibles dentro de la misma red Wi-Fi local."]
        end

        %% Contenedor 3: Signaling & Session Server
        subgraph SignalingSvc ["<center><b>&laquo;container: Node.js / WebSocket Server&raquo;</b><br/>⚡<br/><b>Servidor de Señalización y Salas</b></center>"]
            SS_desc["Gestiona el ciclo de vida de salas, moderación de usuarios y negociación SDP/ICE para conexiones P2P."]
        end

        %% Contenedor 4: Audio Streaming / Media Node (Relay / WebRTC Core)
        subgraph MediaEngine ["<center><b>&laquo;container: WebRTC Node / Mediasoup Engine&raquo;</b><br/>🔊<br/><b>Motor de Transmisión de Audio</b></center>"]
            ME_desc["Recibe el stream de audio del emisor y lo distribuye a múltiples receptores (WebRTC Data/Audio Track)."]
        end

    end

    %% Relaciones entre Usuarios y Contenedores
    Emisor_Node -->|"1. Interactúa con UI y controla la sala<br/><i>[HTTPS / HTML5 Audio API]</i>"| WebApp
    Receptor_Node -->|"2. Interactúa con UI y sintoniza audio<br/><i>[HTTPS / HTML5 Audio API]</i>"| WebApp

    %% Relaciones Internas entre Contenedores
    WebApp -->|"3. Anuncia / Busca salas en red local<br/><i>[mDNS / UDP / Wi-Fi]</i>"| DiscoverySvc
    WebApp -->|"4. Negocia sesión, salas y moderación<br/><i>[WebSocket / JSON]</i>"| SignalingSvc
    WebApp -->|"5. Transmite y recibe flujo de audio P2P/Relay<br/><i>[WebRTC / SRTP / UDP]</i>"| MediaEngine
    SignalingSvc -->|"6. Coordina pares y canales de audio<br/><i>[Internal IPC / Event Bus]</i>"| MediaEngine

    %% Leyenda explícita
    subgraph Leyenda ["Leyenda del Diagrama (C4 Nivel 2)"]
        L_Person["👤 Persona / Actor"]
        L_Container["💻 📦 Contenedor Desplegable (App / Server)"]
        L_Rel["───► Flujo con Propósito y Tecnología"]
    end

    %% Estilos CSS
    classDef personStyle fill:#08427b,stroke:#052e56,color:#fff,stroke-width:1px;
    classDef containerStyle fill:#1168bd,stroke:#0b4884,color:#fff,stroke-width:1px;
    classDef boundaryStyle fill:none,stroke:#666,stroke-width:2px,stroke-dasharray: 5 5;
    classDef legendStyle fill:#f9f9f9,stroke:#ccc,color:#333;

    class Emisor_Node,Receptor_Node,L_Person personStyle;
    class WebApp,DiscoverySvc,SignalingSvc,MediaEngine,L_Container containerStyle;
    class System_Boundary boundaryStyle;
    class Leyenda legendStyle;