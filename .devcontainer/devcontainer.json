{
  "name": "AudioShare Flutter",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": {
      "label": "AudioShare backend",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "AudioShare Flutter Web",
      "onAutoForward": "openBrowser"
    }
  },
  "containerEnv": {
    "CHROME_EXECUTABLE": "/usr/bin/google-chrome"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "dart.flutterSdkPath": "/opt/flutter",
        "dart.openDevTools": "never"
      }
    }
  },
  "postCreateCommand": "flutter pub get",
  "postStartCommand": "flutter doctor --version"
}
